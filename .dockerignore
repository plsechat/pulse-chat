data/
node_modules/
.env
.git/

# Build artifacts never ship from the host — the builder stage produces
# fresh outputs itself (helpers.ts rmIfExists clears build/out first).
apps/client/dist/
apps/server/build/out/
apps/server/build/temp/
packages/plugins/*/dist/

# Local-only artifacts the host accumulates
log/
*.log
test-deploy/
test-results/
.ruvector/
ruvector.db
.claude/
api.html

# E2E suite: specs/node_modules never ship in the image and must not
# bust the docker layer cache on every test edit. The docker/ subdir is
# re-included — the e2e image's own Dockerfile COPYs its entrypoint.
e2e/
!e2e/docker
!e2e/docker/**
