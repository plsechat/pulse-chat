{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/server": {
      "entry": [
        "src/**/__tests__/**/*.test.ts",
        "src/__tests__/*.ts",
        "src/scripts/*.ts",
        "build/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "src/db/migrations/**",
        "data/**",
        "data-test/**"
      ]
    },
    "apps/client": {
      "entry": [
        "src/**/__tests__/**/*.test.ts",
        "src/__tests__/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "dist/**",
        "public/**",
        "src/components/ui/**"
      ],
      "ignoreDependencies": [
        "happy-dom",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/plugin-sdk": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/plugins/discord-bridge": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/plugins/watch-together": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignore": [
    "**/*.d.ts",
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "playwright"
  ],
  "tags": [
    "-pendingBatch"
  ]
}
