{
  "name": "pulse",
  "version": "0.4.2",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "trustedDependencies": [
    "mediasoup"
  ],
  "scripts": {
    "format": "bun run --filter '*' format",
    "check-types": "bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "knip": "knip",
    "knip:production": "knip --production",
    "magic": "bun run format && bun run check-types && bun run lint"
  },
  "devDependencies": {
    "knip": "^5.88.1"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "tar": "^7.5.22"
  }
}