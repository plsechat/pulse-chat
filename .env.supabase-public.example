# =============================================================================
# Pulse — Supabase backend, external / managed Supabase
# (.env.supabase-public.example)
# =============================================================================
# Copy to .env when you run AUTH_BACKEND=supabase against an EXISTING Supabase
# project — Supabase Cloud, or any Supabase you already operate — using the
# regular docker-compose.yml or the binary.
#
#   - For the bundled, fully self-hosted Supabase stack (Postgres + GoTrue +
#     Kong via docker-compose-supabase.yml) use .env.supabase-local.example.
#   - For no Supabase at all (email + password / OIDC) use .env.local.example.

# -----------------------------------------------------------------------------
# Auth backend
# -----------------------------------------------------------------------------
AUTH_BACKEND=supabase

# Your Supabase project's API URL and keys (Project Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client (Vite) build-time vars — baked into the client bundle at build time,
# so they only matter if you build the client yourself. The published image
# reads the server-provided config at runtime instead.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Pulse stores its OWN tables (servers, channels, messages, …) here — separate
# from Supabase Auth. Point at your Supabase project's Postgres, or any
# dedicated Postgres you control.
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# -----------------------------------------------------------------------------
# Social OAuth (Supabase-mediated) — optional
# -----------------------------------------------------------------------------
# Configure the provider in your Supabase project's Auth settings, then toggle
# it on here so Pulse renders the button.
# GOOGLE_OAUTH_ENABLED=false
# DISCORD_OAUTH_ENABLED=false
# FACEBOOK_OAUTH_ENABLED=false
# TWITCH_OAUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Single Sign-On (OIDC) — optional
# -----------------------------------------------------------------------------
# Native OpenID Connect handled by Pulse itself (NOT Supabase / GoTrue). Works
# alongside the supabase backend. Requires AUTH_SECRET to sign the session
# token. In your IdP, register the redirect URI:
#   <your-pulse-url>/auth/oidc/callback
# AUTH_SECRET=                  # >=32 chars; required only if OIDC is enabled
# OIDC_OAUTH_ENABLED=false
# OIDC_LABEL=Authentik
# OIDC_ISSUER=https://auth.example.com/application/o/<app-slug>/
# OIDC_CLIENT_ID=
# OIDC_SECRET=
# OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# WebRTC / Voice
# -----------------------------------------------------------------------------
# PUBLIC_IP=203.0.113.1

# -----------------------------------------------------------------------------
# Registration
# -----------------------------------------------------------------------------
# REGISTRATION_DISABLED=false
#
# Per-method signup switches (default true). Set to "false" to disable a
# method's self-registration; a valid invite still bypasses it. For OIDC-only
# signups, disable password + social:
#   REGISTRATION_PASSWORD_ENABLED=false
#   REGISTRATION_SOCIAL_ENABLED=false
# REGISTRATION_OIDC_ENABLED=true

# -----------------------------------------------------------------------------
# Debug logging
# -----------------------------------------------------------------------------
# DEBUG_LOGGING=true            # writes JSON events to log/debug.log
# DEBUG_LOG_MAX_SIZE_MB=200
# DEBUG_LOG_MAX_FILES=10

# -----------------------------------------------------------------------------
# Federation
# -----------------------------------------------------------------------------
# Allowlist private CIDRs to federate over a LAN (SSRF guard). Comma-separated.
# FEDERATION_ALLOW_PRIVATE_CIDRS=192.168.1.0/24

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# GIPHY_API_KEY=your-giphy-api-key
# TRUST_PROXY=true              # trust X-Forwarded-* behind a reverse proxy
