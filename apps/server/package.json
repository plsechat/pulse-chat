{
  "name": "@pulse/server",
  "version": "0.4.1",
  "module": "src/index.ts",
  "exports": {
    "./types": "./src/types.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "dev:debug": "DEBUG=* bun --watch ./src/index.ts",
    "build": "tsc -b && bun ./build/build.ts",
    "db:gen": "bunx drizzle-kit generate",
    "format": "prettier --write \"**/*.ts*\" --config ./.prettierrc.json",
    "lint": "eslint ./src --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bash scripts/test-per-file.sh",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "@types/ini": "^4.1.1",
    "@types/ws": "^8.18.2",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pulse/plugin-sdk": "workspace:*",
    "@pulse/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@trpc/server": "^11.19.0",
    "chalk": "^5.6.2",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "ini": "^5.0.0",
    "jose": "^6.2.13",
    "mediasoup": "3.19.17",
    "postgres": "^3.4.9",
    "queue": "^7.0.0",
    "semver": "^7.8.5",
    "string-argv": "^0.3.2",
    "systeminformation": "^5.33.18",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}